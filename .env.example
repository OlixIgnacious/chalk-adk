# Gemini API Key (from Google AI Studio - Free Tier available)
GEMINI_API_KEY=your_gemini_api_key_here

# (Optional) Mistral API Key (from console.mistral.ai)
MISTRAL_API_KEY=

# (Optional) Groq API Key (from console.groq.com)
GROQ_API_KEY=

# (Optional) OpenRouter API Key
OPENROUTER_API_KEY=

# Model Preferences
CURATOR_MODEL=gemini-3.5-flash-lite
WRITER_MODEL=gemini-3.8-flash
VERIFIER_MODEL=gemini-3.8-flash

# Pacing delay between agent invocations in seconds (to protect 15 RPM free tier)
REQUEST_PACING_SECONDS=4.5

